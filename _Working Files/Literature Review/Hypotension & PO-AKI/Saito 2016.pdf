                     <rdf:Seq>
                        <rdf:li rdf:parseType="Resource">
                           <pdfaProperty:category>external</pdfaProperty:category>
                           <pdfaProperty:description>The aggregation type specifies the unit of aggregation for a content collection. 
Comment 
